      "last_frame_exclusive": 13260,
      "lyrical_theme_paraphrase": "直面必然性，仍选择奋力活着",
      "visual_direction": "主角不再攻击系统，而是从自己的碎片中逐层重组；所有字符共同组成向前的路径。",
      "palette": "纯白/暖金/蓝",
      "emotional_intensity_1_to_10": 10,
      "measured_avg_rms_linear": 0.2965
