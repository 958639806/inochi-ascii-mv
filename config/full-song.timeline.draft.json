      "first_frame": 0,
      "last_frame_exclusive": 1200,
      "lyrical_theme_paraphrase": "空白与预设正确",
      "visual_direction": "孤独的光标逐渐生成由字符构成的人形，周围系统开始自动生成对生命的评分。",
      "palette": "黑/纸白/微蓝",
      "emotional_intensity_1_to_10": 3,
      "measured_avg_rms_linear": 0.1918
    },
    {
      "id": "verse1",
      "start_s": 20,
      "end_s": 39,
      "first_frame": 1200,
      "last_frame_exclusive": 2340,
      "lyrical_theme_paraphrase": "正确话语与人性自相矛盾",
      "visual_direction": "一个巨大的告示系统不断输出正确建议；镜头转过去，操作者是同一个主角。",
      "palette": "冷白/黄",
      "emotional_intensity_1_to_10": 4,
      "measured_avg_rms_linear": 0.1354
    },
    {
      "id": "prechorus1",
      "start_s": 39,
      "end_s": 58,
      "first_frame": 2340,
      "last_frame_exclusive": 3480,
      "lyrical_theme_paraphrase": "社交冷漠与道德消费",
      "visual_direction": "消息流像观众席，人群不断点亮表情，但中央求助信号无人响应；笑声在空间里回响。",
      "palette": "灰蓝/荧黄",
      "emotional_intensity_1_to_10": 6,
      "measured_avg_rms_linear": 0.2448
    },
    {
      "id": "chorus1",
      "start_s": 58,
      "end_s": 77,
      "first_frame": 3480,
      "last_frame_exclusive": 4620,
      "lyrical_theme_paraphrase": "第一次控诉：我们都身处矛盾",
      "visual_direction": "字符人形同时化作控诉者与被审视者；每次节拍撞击画面，都有新层文字碎裂。",
      "palette": "黑/暗红/白",
      "emotional_intensity_1_to_10": 9,
      "measured_avg_rms_linear": 0.302
    },
    {
      "id": "break1",
      "start_s": 77,
      "end_s": 87,
      "first_frame": 4620,
      "last_frame_exclusive": 5220,
      "lyrical_theme_paraphrase": "短暂喘息",
      "visual_direction": "碎片没有消失而是悬浮着，摄像机掠过一块布满裂纹的玻璃。",
      "palette": "深灰/蓝",
      "emotional_intensity_1_to_10": 3,
      "measured_avg_rms_linear": 0.1665
    },
    {
      "id": "verse2",
      "start_s": 87,
      "end_s": 125,
      "first_frame": 5220,
      "last_frame_exclusive": 7500,
      "lyrical_theme_paraphrase": "贫困、虚无、衰老与逃离现实",
      "visual_direction": "房间由字符填满，床铺成为时钟，屏幕里漂浮不死之身的科幻幻景，然后幻景消散。",
      "palette": "深蓝/紫",
      "emotional_intensity_1_to_10": 5,
      "measured_avg_rms_linear": 0.2268
    },
    {
      "id": "prechorus2",
      "start_s": 125,
      "end_s": 145,
      "first_frame": 7500,
      "last_frame_exclusive": 8700,
      "lyrical_theme_paraphrase": "再次面对自我矛盾",
      "visual_direction": "把自我辩解写成可执行规则，但两条规则互相冲突，主角被同一套规则困住。",
      "palette": "铅灰/红",
      "emotional_intensity_1_to_10": 7,
      "measured_avg_rms_linear": 0.2587
    },
    {
      "id": "chorus2",
      "start_s": 145,
      "end_s": 165,
      "first_frame": 8700,
      "last_frame_exclusive": 9900,
      "lyrical_theme_paraphrase": "第二次控诉：没有人置身事外",
      "visual_direction": "人群像复制粘贴一般延伸，字符各自喊着矛盾的口号，镜头穿入个人内部。",
      "palette": "暗红/灰白",
      "emotional_intensity_1_to_10": 9,
      "measured_avg_rms_linear": 0.2938
    },
    {
      "id": "break2",
      "start_s": 165,
      "end_s": 173,
      "first_frame": 9900,
      "last_frame_exclusive": 10380,
      "lyrical_theme_paraphrase": "彻底失声",
      "visual_direction": "画面急速退回极简单色、噪声消失，只剩心跳形态的一个字符。",
      "palette": "黑/白",
      "emotional_intensity_1_to_10": 2,
      "measured_avg_rms_linear": 0.0468
    },
    {
      "id": "bridge",
      "start_s": 173,
      "end_s": 202,
      "first_frame": 10380,
      "last_frame_exclusive": 12120,
      "lyrical_theme_paraphrase": "从抽象辩论转向具体的人",
      "visual_direction": "那些抽象名词变成价格标签并随后失效；镜头最后停在一个沉默的“你”的轮廓前。",
      "palette": "蓝黑/淡金",
      "emotional_intensity_1_to_10": 7,
      "measured_avg_rms_linear": 0.1482
    },
